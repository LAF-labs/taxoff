{
 "ir": 2,
 "id": "hometax.invoice.bulk",
 "version": "1.0.1",
 "portal": "hometax",
 "profileKinds": [
  "business"
 ],
 "effects": [
  "issue_document",
  "send"
 ],
 "inputs": {
  "rows": {
   "type": "invoice_rows",
   "required": true
  },
  "supplier": {
   "type": "party",
   "required": true
  },
  "confirmCount": {
   "type": "string",
   "required": true
  },
  "confirmTotal": {
   "type": "string",
   "required": true
  }
 },
 "preconditions": [
  {
   "profileHas": "signMethod"
  }
 ],
 "recovery": {
  "default": {
   "retry": 2,
   "then": "handoff"
  }
 },
 "steps": [
  {
   "id": "s0",
   "type": "checkpoint",
   "name": "session",
   "expect": {
    "exists": "hometax.header.logo"
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml",
   "sessionRequired": true,
   "reentry": "reload"
  },
  {
   "id": "s2",
   "type": "branch",
   "on": {
    "textMatches": {
     "target": "hometax.header.loginLink",
     "patternRef": "login.loggedIn"
    }
   },
   "cases": {
    "true": "s10"
   },
   "default": "s3"
  },
  {
   "id": "s3",
   "type": "click",
   "target": "hometax.header.loginLink"
  },
  {
   "id": "s4",
   "type": "wait",
   "for": "selector",
   "value": "hometax.login.certTab",
   "timeoutMs": 30000
  },
  {
   "id": "s4a",
   "type": "click",
   "target": "hometax.login.certOpen",
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4b",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.root",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4c",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.table",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8",
   "type": "click",
   "target": "hometax.cert.storageHdd",
   "onFail": {
    "retry": 1,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8a",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.driveHdd",
   "timeoutMs": 15000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8b",
   "type": "click",
   "target": "hometax.cert.driveHdd",
   "onFail": {
    "retry": 1,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4d",
   "type": "pick",
   "target": "hometax.cert.table",
   "by": "$profile.certName",
   "ifNone": "s4e",
   "then": "s4g",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4e",
   "type": "handoff",
   "reason": "cert.pickOne",
   "resumeAt": "s4f",
   "code": "cert.pick_needed"
  },
  {
   "id": "s4f",
   "type": "pick",
   "target": "hometax.cert.table",
   "use": "selected",
   "remember": "certName",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s4g",
   "type": "human",
   "kind": "secret",
   "target": "hometax.cert.password",
   "prompt": "cert.passwordPrompt",
   "ttlMs": 120000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4h",
   "type": "click",
   "target": "hometax.cert.loginConfirm",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s5",
   "type": "wait",
   "for": "text",
   "value": "hometax.login.successMarker",
   "timeoutMs": 60000,
   "pace": "slow",
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s6",
   "type": "branch",
   "on": {
    "exists": "hometax.header.logo"
   },
   "cases": {
    "true": "s10"
   },
   "default": "handoff"
  },
  {
   "id": "s7",
   "type": "checkpoint",
   "name": "simple_login",
   "expect": {
    "exists": "hometax.header.logo"
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml",
   "reentry": "reload"
  },
  {
   "id": "s7a",
   "type": "goto",
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml"
  },
  {
   "id": "s7b",
   "type": "click",
   "target": "hometax.header.loginLink"
  },
  {
   "id": "s7c",
   "type": "wait",
   "for": "selector",
   "value": "hometax.login.simpleTab",
   "timeoutMs": 30000
  },
  {
   "id": "s7d",
   "type": "click",
   "target": "hometax.login.simpleTab"
  },
  {
   "id": "s7e",
   "type": "handoff",
   "reason": "login.simpleAuth",
   "resumeAt": "s7f",
   "code": "login.simple_auth"
  },
  {
   "id": "s7f",
   "type": "wait",
   "for": "text",
   "value": "hometax.login.successMarker",
   "timeoutMs": 60000,
   "pace": "slow",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s7g",
   "type": "branch",
   "on": {
    "exists": "hometax.header.logo"
   },
   "cases": {
    "true": "s10"
   },
   "default": "handoff"
  },
  {
   "id": "s10",
   "type": "click",
   "target": "hometax.menu.bulk"
  },
  {
   "id": "s10a",
   "type": "wait",
   "for": "selector",
   "value": "hometax.bulk.grid",
   "timeoutMs": 30000
  },
  {
   "id": "s11",
   "type": "checkpoint",
   "name": "bulk",
   "expect": {
    "exists": "hometax.bulk.grid"
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml&tmIdx=46&tm2lIdx=4601010000&tm3lIdx=4601010500",
   "sessionRequired": true,
   "reentry": "reload"
  },
  {
   "id": "s11a",
   "type": "wait",
   "for": "gone",
   "value": "hometax.common.processing",
   "timeoutMs": 30000
  },
  {
   "id": "s12",
   "type": "upload",
   "sheet": "hometax_bulk_v1",
   "rows": "$inputs.rows",
   "supplier": "$inputs.supplier",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s13",
   "type": "click",
   "target": "hometax.bulk.convert"
  },
  {
   "id": "s13a",
   "type": "wait",
   "for": "gone",
   "value": "hometax.common.processing",
   "timeoutMs": 30000
  },
  {
   "id": "s14",
   "type": "grid_check",
   "rows": "$inputs.rows",
   "supplier": "$inputs.supplier",
   "expect": "converted",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s15",
   "type": "readback",
   "fields": [
    "bulkCount"
   ]
  },
  {
   "id": "s15a",
   "type": "assert",
   "cond": {
    "readbackEquals": {
     "fieldKey": "bulkCount",
     "ref": "$inputs.confirmCount"
    }
   },
   "code": "assert.bulk_count_mismatch",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s20",
   "type": "gate",
   "card": "bulk.confirm",
   "authorizes": [
    "s21"
   ],
   "waitMs": 600000
  },
  {
   "id": "s21",
   "type": "submit",
   "target": "hometax.bulk.issue",
   "intent": "$intent.id",
   "verify": "s30",
   "expectConfirm": "bulk.confirmIssue",
   "expectConfirmVars": {
    "count": "$inputs.confirmCount",
    "total": "$inputs.confirmTotal"
   },
   "signFlow": {
    "method": "$profile.signMethod",
    "methodTargets": {
     "cert": "hometax.invoice.auth.cert",
     "simple_auth": "hometax.invoice.auth.simpleAuth"
    },
    "steps": {
     "cert": [
      "human:secret"
     ],
     "simple_auth": [
      "wait:push"
     ]
    },
    "readyTarget": "hometax.invoice.sign.certTable",
    "maxWaitMs": 180000,
    "confirmTarget": "hometax.invoice.sign.confirm",
    "certPick": {
     "target": "hometax.invoice.sign.certTable",
     "by": "$profile.certName"
    }
   },
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s30",
   "type": "verify",
   "lookup": {
    "playbook": "hometax.invoice.buyer_lookup",
    "match": {
     "counterpartBizNo": "$inputs.rows[0].buyer.bizNo",
     "issueDate": "$inputs.rows[0].writeDate",
     "supplyAmount": "$inputs.rows[0].supply",
     "taxAmount": "$inputs.rows[0].tax"
    },
    "window": "issueDate",
    "baseline": "pre_gate_snapshot",
    "notCommittedPolicy": {
     "minElapsedMs": 60000,
     "lookups": 2
    },
    "bind": {
     "approvalNo": "approvalNo"
    }
   },
   "on": {
    "committed": "s31",
    "not_committed": "s33",
    "unknown": "handoff"
   },
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s31",
   "type": "grid_check",
   "rows": "$inputs.rows",
   "supplier": "$inputs.supplier",
   "expect": "issued",
   "bind": "approvalNos",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s32",
   "type": "end",
   "status": "success"
  },
  {
   "id": "s33",
   "type": "end",
   "status": "failed",
   "code": "bulk.not_issued"
  }
 ],
 "postconditions": [
  {
   "varSet": "approvalNos"
  }
 ],
 "pacing": {
  "profile": "interactive"
 },
 "closeWindows": [
  "login.certNoticeWindow"
 ],
 "closeLayers": {
  "targets": [
   "hometax.layer.btnClose",
   "hometax.layer.btnCloseAlt"
  ],
  "until": "s12"
 }
}
