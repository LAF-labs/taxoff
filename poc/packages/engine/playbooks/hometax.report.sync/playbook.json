{
 "ir": 2,
 "id": "hometax.report.sync",
 "version": "1.0.1",
 "portal": "hometax",
 "profileKinds": [
  "business"
 ],
 "effects": [],
 "inputs": {
  "plan": {
   "type": "report_plan",
   "required": true
  }
 },
 "preconditions": [
  {
   "profileHas": "signMethod"
  }
 ],
 "recovery": {
  "default": {
   "retry": 2,
   "then": "handoff"
  }
 },
 "steps": [
  {
   "id": "s0",
   "type": "checkpoint",
   "name": "session",
   "expect": {
    "exists": "hometax.header.logo"
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml",
   "sessionRequired": true,
   "reentry": "reload"
  },
  {
   "id": "s2",
   "type": "branch",
   "on": {
    "textMatches": {
     "target": "hometax.header.loginLink",
     "patternRef": "login.loggedIn"
    }
   },
   "cases": {
    "true": "s10"
   },
   "default": "s3"
  },
  {
   "id": "s3",
   "type": "click",
   "target": "hometax.header.loginLink"
  },
  {
   "id": "s4",
   "type": "wait",
   "for": "selector",
   "value": "hometax.login.certTab",
   "timeoutMs": 30000
  },
  {
   "id": "s4a",
   "type": "click",
   "target": "hometax.login.certOpen",
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4b",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.root",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4c",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.table",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8",
   "type": "click",
   "target": "hometax.cert.storageHdd",
   "onFail": {
    "retry": 1,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8a",
   "type": "wait",
   "for": "selector",
   "value": "hometax.cert.driveHdd",
   "timeoutMs": 15000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s8b",
   "type": "click",
   "target": "hometax.cert.driveHdd",
   "onFail": {
    "retry": 1,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4d",
   "type": "pick",
   "target": "hometax.cert.table",
   "by": "$profile.certName",
   "ifNone": "s4e",
   "then": "s4g",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4e",
   "type": "handoff",
   "reason": "cert.pickOne",
   "resumeAt": "s4f",
   "code": "cert.pick_needed"
  },
  {
   "id": "s4f",
   "type": "pick",
   "target": "hometax.cert.table",
   "use": "selected",
   "remember": "certName",
   "timeoutMs": 30000,
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s4g",
   "type": "human",
   "kind": "secret",
   "target": "hometax.cert.password",
   "prompt": "cert.passwordPrompt",
   "ttlMs": 120000,
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s4h",
   "type": "click",
   "target": "hometax.cert.loginConfirm",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s5",
   "type": "wait",
   "for": "text",
   "value": "hometax.login.successMarker",
   "timeoutMs": 60000,
   "pace": "slow",
   "onFail": {
    "retry": 0,
    "then": "checkpoint:simple_login"
   }
  },
  {
   "id": "s6",
   "type": "branch",
   "on": {
    "exists": "hometax.header.logo"
   },
   "cases": {
    "true": "s10"
   },
   "default": "handoff"
  },
  {
   "id": "s7",
   "type": "checkpoint",
   "name": "simple_login",
   "expect": {
    "exists": "hometax.header.logo"
   },
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml",
   "reentry": "reload"
  },
  {
   "id": "s7a",
   "type": "goto",
   "url": "https://hometax.go.kr/websquare/websquare.html?w2xPath=/ui/pp/index_pp.xml"
  },
  {
   "id": "s7b",
   "type": "click",
   "target": "hometax.header.loginLink"
  },
  {
   "id": "s7c",
   "type": "wait",
   "for": "selector",
   "value": "hometax.login.simpleTab",
   "timeoutMs": 30000
  },
  {
   "id": "s7d",
   "type": "click",
   "target": "hometax.login.simpleTab"
  },
  {
   "id": "s7e",
   "type": "handoff",
   "reason": "login.simpleAuth",
   "resumeAt": "s7f",
   "code": "login.simple_auth"
  },
  {
   "id": "s7f",
   "type": "wait",
   "for": "text",
   "value": "hometax.login.successMarker",
   "timeoutMs": 60000,
   "pace": "slow",
   "onFail": {
    "retry": 0,
    "then": "handoff"
   }
  },
  {
   "id": "s7g",
   "type": "branch",
   "on": {
    "exists": "hometax.header.logo"
   },
   "cases": {
    "true": "s10"
   },
   "default": "handoff"
  },
  {
   "id": "s10",
   "type": "report_sync",
   "plan": "$inputs.plan",
   "onFail": {
    "retry": 0,
    "then": "abort"
   }
  },
  {
   "id": "s11",
   "type": "end",
   "status": "success"
  }
 ],
 "postconditions": [],
 "pacing": {
  "profile": "interactive"
 },
 "closeWindows": [
  "login.certNoticeWindow"
 ],
 "closeLayers": {
  "targets": [
   "hometax.layer.btnClose",
   "hometax.layer.btnCloseAlt"
  ],
  "until": "s10"
 }
}
