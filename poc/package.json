{
  "name": "sax-poc",
  "private": true,
  "description": "소버린 AX PoC 스파이크(폐기 전제, ADR-017)",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.11.0 <27"
  },
  "scripts": {
    "build": "tsc -b",
    "build:touchid": "bash packages/vault/native/mac/build.sh packages/vault/native/mac/build/touchid.app",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "start": "pnpm build && electron apps/desktop",
    "bundles": "node --conditions=development scripts/bundles-digest.ts",
    "toolsets": "node --conditions=development scripts/toolsets-released.ts",
    "s9": "node --conditions=development scripts/s9-decisions.ts",
    "start:hometax": "pnpm build && electron apps/desktop/dist/shell.js --portal=hometax",
    "e2e": "pnpm build && electron apps/desktop/e2e-dist/shell-e2e.js",
    "ci:promotion": "node scripts/ci-promotion-check.mjs",
    "test:security": "node scripts/ci-security.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sax/engine": "workspace:*",
    "@sax/model": "workspace:*",
    "@sax/net": "workspace:*",
    "@sax/redaction": "workspace:*",
    "@types/node": "24.19.2",
    "electron": "45.4.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
